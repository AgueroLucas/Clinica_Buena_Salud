DATABASE_URL=postgresql://usuario:contraseña@host/base?sslmode=require
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# Secretos de seguridad (obligatorios en produccion)
# 32-byte hex generated with: openssl rand -hex 32
SESSION_SECRET=change-me
ENCRYPTION_KEY=change-me

# Verificacion anti-bot (Cloudflare Turnstile) para reservar turnos.
# Si se dejan vacias, el CAPTCHA queda desactivado y solo se exige una cuenta
# autenticada (util en desarrollo). En produccion configura ambas claves:
# la site key es publica (navegador) y la secret key es privada (servidor).
# Obtener claves: https://dash.cloudflare.com/ -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Proteccion del endpoint destructivo POST /api/seed?force=1 (borra y recarga la
# base). Con datos existentes, el wipe exige una sesion admin valida o el header
# X-Seed-Secret con este valor. Vacio = solo un admin autenticado puede forzarlo.
SEED_SECRET=

# Centro de ayuda / WhatsApp
# Numero internacional, solo digitos, sin "+" ni espacios. Ej: 5491155555555
NEXT_PUBLIC_WHATSAPP_NUMBER=542634368835
# Telefono visible para el boton "Llamar" (puede llevar +, espacios y guiones)
NEXT_PUBLIC_CLINIC_PHONE=+54 263 436-8835
# Opcional: numero que usa el servidor para armar el link. Si esta vacio,
# se usa NEXT_PUBLIC_WHATSAPP_NUMBER.
WHATSAPP_NUMBER=

# Optional integrations (safe to leave empty in dev)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
